rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // An authenticated user can only read and write their own workspace.
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
    // All other documents and collections are private by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
